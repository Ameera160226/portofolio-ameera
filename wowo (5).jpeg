<div class="hldetail">
<h1 class="clearfix ">Lahir Secara Organik, Citra Prabowo Gemoy karena Rasa Kagum Milenial dan Gen Z</h1> 
</div>
<div class="datehour">
Senin, 27 November 2023 - 13:55:32 WIB     
	  
  </div>

<br>

	<div class="headline-item" >
		<div class="panel-block" >
									<img src="https://imcnews.id/foto_berita/2023/11/27/47prabowo000000000000000000.jpeg" width="800"  alt="Prabowo Subianto berjoget yang melahirkan citra Prabowo Gemoy">
							</div>  
	</div>
			<div class="tagline-top putih clearfix" style="padding:10px 0;*border-bottom: 2px solid #ff0000;">
				 <span style="font-style: italic;font-size:14px;">Prabowo Subianto berjoget yang melahirkan citra Prabowo Gemoy </span> 
			<!--	 <span style="font-style: italic;">()</span> -->
			</div>
			 
<div class="detail-social-share-ab">
										
					<div class="autor ">
						<div class="reporter"></div>
						<div class="nmreporter">
														<!-------- jurnalis -------->
							 <table> <tr><td style="  float: left;margin-right:20px;">
							<div></div>
							<span>Penulis</span> 
							 </td>
						<!--	 <td>
							<div></div>
							<span>Editor</span></td> -->
							 </tr>
							 </table>
							 
						</div>
					</div>
					<div class="r">
						<div class="sosmed right">
					
<!-- AddThis Button BEGIN -->

<!-- AddThis Button END -->
						</div>
						<div class="settingfont right">
							<a href="javascript:void(0)" class="font-button inactive minus" title="Huruf kecil">A</a>  
							<a href="javascript:void(0)" class="font-button active normal" title="Huruf normal">A</a> 
